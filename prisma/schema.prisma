// swifty-agent2 server data model (SQLite via Prisma driver adapter).
// Enum-like columns are plain strings; the allowed values live in src/db/constants.js.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Conversation {
  id                Int      @id @default(autoincrement())
  userId            String
  status            String   @default("进行中")
  summary           String?
  summaryUptoMsgId  Int?
  layer1FromMsgId   Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

model ConversationSummary {
  id             Int      @id @default(autoincrement())
  conversationId Int
  seq            Int
  fromMsgId      Int
  uptoMsgId      Int
  content        String
  createdAt      DateTime @default(now())

  @@index([conversationId])
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int
  role           String
  content        String?
  toolCalls      String?
  toolCallId     String?
  createdAt      DateTime @default(now())

  @@index([conversationId])
}

model Faq {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model Ticket {
  ticketNo       String   @id
  conversationId Int
  description    String
  ticketType     String
  status         String   @default("待处理")
  createdAt      DateTime @default(now())

  @@index([conversationId])
}

model KnowledgeChunk {
  id              Int      @id @default(autoincrement())
  category        String
  questions       String
  answer          String
  sectionPath     String?
  contentType     String?
  isKeyClause     Int      @default(0)
  prevChunkId     Int?
  nextChunkId     Int?
  vectorId        String?
  vectorizeStatus String   @default("pending")
  // Dense embedding (JSON array of floats) written by the vectorize step.
  embedding       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model QaExtractionStaging {
  id        Int      @id @default(autoincrement())
  batchNo   String
  sourceRef String?
  question  String
  answer    String
  status    String   @default("extracted")
  createdAt DateTime @default(now())
}

model ToolAuditLog {
  id             Int      @id @default(autoincrement())
  conversationId Int?
  toolCallId     String?
  toolName       String
  toolSource     String
  mcpServer      String?
  arguments      String?
  resultSummary  String?
  status         String
  errorMessage   String?
  retryCount     Int      @default(0)
  durationMs     Int?
  createdAt      DateTime @default(now())
}

model LowConfidenceQuestion {
  id               Int      @id @default(autoincrement())
  conversationId   Int?
  rawQuestion      String
  source           String
  reason           String?
  retrievedChunks  String?
  matchedReviewId  Int?
  createdAt        DateTime @default(now())

  matchedReview        ReviewQueue?          @relation(fields: [matchedReviewId], references: [id])
  topicClassifications TopicClassification[]
}

model ReviewQueue {
  id                 Int      @id @default(autoincrement())
  normalizedQuestion String
  aiSuggestedAnswer  String?
  occurrenceCount    Int      @default(1)
  reviewStatus       String   @default("待审")
  approvedAnswer     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  lowConfidenceQuestions LowConfidenceQuestion[]
}

model EvalRun {
  id          Int      @id @default(autoincrement())
  triggeredBy String   @default("定时")
  datasetSize Int
  metrics     String
  createdAt   DateTime @default(now())
}

model FaithCase {
  id            Int       @id @default(autoincrement())
  evalId        String    @unique
  bucket        String
  query         String
  strategy      String    @default("hybrid_rerank")
  answer        String
  reason        String
  citations     String?
  judgeModel    String?
  status        String    @default("未解决")
  seenCount     Int       @default(1)
  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  resolution    String?
  resolvedAt    DateTime?
}

model TopicClassification {
  id           Int      @id @default(autoincrement())
  questionId   Int
  labels       String
  classifiedAt DateTime @default(now())

  question LowConfidenceQuestion @relation(fields: [questionId], references: [id])

  @@index([questionId])
}
