{
  "name": "server",
  "version": "0.0.0",
  "description": "swifty-agent2 customer-service agent backend",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "lint": "eslint --cache --quiet ./",
    "lint:fix": "eslint --cache --fix --quiet ./",
    "lint:all": "eslint ./",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "kb:build": "node scripts/build-kb.ts",
    "kb:vectorize": "node scripts/vectorize-kb.ts",
    "kb:mine": "node scripts/mine-knowledge.ts",
    "kb:reset": "node scripts/kb-reset.ts",
    "kb:preview": "node scripts/show-kb.ts",
    "kb:repatch": "node scripts/kb-repatch.ts",
    "seed:conv": "node scripts/seed-conv.ts",
    "flywheel": "node scripts/flywheel-pipeline.ts",
    "eval:rag": "node scripts/eval-ch04.ts",
    "eval:flywheel": "node scripts/eval-flywheel.ts",
    "eval:retrieval": "node scripts/eval-retrieval.ts",
    "eval:judge": "node scripts/judge-check.ts",
    "calibrate": "node scripts/calibrate-confidence.ts",
    "cost:report": "node scripts/cost-by-intent.ts",
    "mcp:logistics": "node src/mcp-servers/logistics-server.ts",
    "mcp:aftersales": "node src/mcp-servers/aftersales-server.ts",
    "git:commit": "git add -A && git commit -m \"feat: Introduce new features\"",
    "git:commit:skip": "git add -A && git commit -m \"feat: Introduce new features [skip ci]\"",
    "git:push": "pnpm git:commit && git push origin main",
    "git:push:skip": "pnpm git:commit:skip && git push origin main"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@langchain/anthropic": "^1.5.10",
    "@langchain/classic": "^1.0.48",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "@langchain/openai": "^1.5.13",
    "@langchain/textsplitters": "^1.0.1",
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "ajv": "8.20.0",
    "hono": "^4.13.7",
    "hono-pino": "^0.10.3",
    "langchain": "^1.5.11",
    "openai": "^7.15.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "prisma": "7.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
