{
  "name": "server",
  "version": "0.0.0",
  "description": "swifty-agent2 customer-service agent backend",
  "main": "src/index.ts",
  "imports": {
    "#/*": "./src/*",
    "#generated/*": "./generated/*",
    "#scripts/*": "./scripts/*",
    "#tests/*": "./tests/*"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:fe": "pnpm --filter fe dev",
    "start": "tsx src/index.ts",
    "lint": "concurrently \"eslint --cache --fix --quiet ./\" \"uv run ruff check .\"",
    "format": "prettier -w ./ --experimental-cli && uv run ruff format .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "git:commit": "git add -A && git commit -m \"feat: Introduce new features\"",
    "git:commit:skip": "git add -A && git commit -m \"feat: Introduce new features [skip ci]\"",
    "git:push": "pnpm git:commit && git push origin main",
    "git:push:skip": "pnpm git:commit:skip && git push origin main"
  },
  "keywords": [
    "langchain",
    "langgraph"
  ],
  "author": "https://github.com/hangtiancheng",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@huggingface/tokenizers": "^0.2.0",
    "@langchain/anthropic": "^1.5.10",
    "@langchain/classic": "^1.0.48",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "@langchain/openai": "^1.5.13",
    "@langchain/textsplitters": "^1.0.1",
    "@langfuse/langchain": "^5.11.1",
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "ajv": "8.20.0",
    "hono": "^4.13.8",
    "hono-pino": "^0.10.3",
    "langchain": "^1.5.11",
    "onnxruntime-node": "^1.30.0",
    "openai": "^7.17.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.1",
    "@webgpu/types": "^0.1.72",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
