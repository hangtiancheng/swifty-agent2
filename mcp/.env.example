# Personal access token for the GitLab API (gitlab_* tools).
# Secret — never commit .env. When unset, the gitlab_* tools answer with a
# clear unavailable error per call; the server itself still starts.
GITLAB_PRIVATE_TOKEN=

# Self-hosted GitLab instance URL. When unset, the gitlab_* tools are
# unavailable (the server still starts).
#GITLAB_BASE_URL=https://gitlab.example.com
