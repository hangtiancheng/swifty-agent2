# ============================================================
# Three direct upstreams (no gateway). The three key slots are independent;
# use the same provider value for all three if you only have one account.
# ============================================================

# --- chat ---
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-v4-flash
CHAT_API_KEY=sk-xxx

# Explicit model context window (tokens). Empty = look up by model name (src/core/budget.ts).
# MODEL_CONTEXT_WINDOW=1000000

# Intent/summary slots default to the chat group; set these only to split providers.
# INTENT_MODEL=
# INTENT_BASE_URL=
# INTENT_API_KEY=
# SUMMARY_MODEL=
# SUMMARY_BASE_URL=
# SUMMARY_API_KEY=

# Thinking chain: adaptive (model decides) / disabled.
CHAT_THINKING=adaptive
# CHAT_REASONING_EFFORT=low
# MiniMax only: keep reasoning in the separate reasoning_content field.
CHAT_REASONING_SPLIT=true

# --- embeddings (qwen3.7-text-embedding-flash) ---
EMBED_MODEL=qwen3.7-text-embedding-flash
EMBED_API_KEY=sk-xxx
# EMBED_BASE_URL=https://maas.aliyuncs.com/compatible-mode/v1

# --- rerank (qwen3.7-text-rerank) ---
RERANK_MODEL=qwen3.7-text-rerank
RERANK_API_KEY=sk-xxx
# RERANK_BASE_URL=https://maas.aliyuncs.com/compatible-mode/v1

# --- storage ---
DATABASE_URL=file:./data/swifty-agent2.db
CHECKPOINTER_DB_PATH=data/checkpoints.sqlite

# --- milvus dense bridge (optional) ---
# Empty = dense retrieval runs in-process over SQLite embeddings (no extra service needed).
# Set to the Python gRPC bridge address to make Milvus Lite the authoritative dense store;
# start the bridge with `make milvus-up`. BM25 always stays in-process. See src/milvus/server.py.
# MILVUS_RPC_URL=127.0.0.1:50051
# MILVUS_COLLECTION=knowledge

# --- tools / MCP ---
MCP_LOGISTICS_URL=http://127.0.0.1:8101/mcp
MCP_AFTERSALES_URL=http://127.0.0.1:8102/mcp
DEMO_TICKET_DELAY_SECONDS=0

# --- observability (all three set = Langfuse tracing enabled) ---
# LANGFUSE_PUBLIC_KEY=pk-lf-swifty-agent2-local
# LANGFUSE_SECRET_KEY=sk-lf-swifty-agent2-local
# LANGFUSE_BASE_URL=http://localhost:3000

# --- server ---
HOST=127.0.0.1
PORT=8000
